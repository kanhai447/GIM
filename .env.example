# GIM local development configuration template.
# Copy values into .env.local and never commit real secrets.

APP_ENV=development
LOG_LEVEL=info

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=gim
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_POOL_SIZE=20

ETCD_ENDPOINTS=http://127.0.0.1:2379
ETCD_DIAL_TIMEOUT=5s

JWT_SECRET=CHANGE_ME
JWT_EXPIRE_SECONDS=CHANGE_ME

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

AUTH_API_PORT=CHANGE_ME
USER_API_PORT=CHANGE_ME
CHAT_API_PORT=CHANGE_ME
GROUP_API_PORT=CHANGE_ME
FILE_API_PORT=CHANGE_ME
SETTINGS_API_PORT=CHANGE_ME
LOGS_API_PORT=CHANGE_ME

AUTH_RPC_PORT=CHANGE_ME
USER_RPC_PORT=CHANGE_ME
CHAT_RPC_PORT=CHANGE_ME
GROUP_RPC_PORT=CHANGE_ME
FILE_RPC_PORT=CHANGE_ME
SETTINGS_RPC_PORT=CHANGE_ME

CHAT_WS_PATH=CHANGE_ME
GROUP_WS_PATH=CHANGE_ME

FILE_STORAGE_ROOT=./storage/uploads
FILE_MAX_UPLOAD_BYTES=CHANGE_ME

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_LOG_TOPIC=CHANGE_ME

WEB_ORIGIN=CHANGE_ME
ADMIN_ORIGIN=CHANGE_ME
