# GIM Web talks only to the public Gateway. Copy this file to .env.local for local overrides.
VITE_API_BASE_URL=/
VITE_API_TIMEOUT_MS=10000
# Leave empty for same-origin ws:// or wss://. Set only when Gateway WS uses a separate public origin.
VITE_WS_BASE_URL=
VITE_DEV_GATEWAY_TARGET=http://localhost:8080
