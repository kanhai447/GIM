# Copy to .env.compose.local and replace every CHANGE_ME value.
# The local file is gitignored and is loaded at container runtime.
APP_ENV=development
LOG_LEVEL=info

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=gim
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=gim
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_POOL_SIZE=20

ETCD_ENDPOINTS=http://etcd:2379
ETCD_DIAL_TIMEOUT=5s
ETCD_SERVICE_TTL=15s
SERVICE_STARTUP_TIMEOUT=30s
SERVICE_SHUTDOWN_TIMEOUT=15s

JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRE_SECONDS=7200

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_DISCOVERY_TIMEOUT=2s
GATEWAY_AUTH_TIMEOUT=3s
GATEWAY_PROXY_TIMEOUT=15s

INTERNAL_API_HOST=0.0.0.0
INTERNAL_BIND_HOST=0.0.0.0
AUTH_API_HOST=auth-api
USER_API_HOST=user-api
CHAT_API_HOST=chat-api
GROUP_API_HOST=group-api
FILE_API_HOST=file-api
SETTINGS_API_HOST=settings-api
LOGS_API_HOST=logs-api
USER_RPC_HOST=user-rpc
GROUP_RPC_HOST=group-rpc

AUTH_API_PORT=8081
AUTH_API_INSTANCE_ID=auth-api-compose
USER_API_PORT=8082
USER_API_INSTANCE_ID=user-api-compose
CHAT_API_PORT=8083
CHAT_API_INSTANCE_ID=chat-api-compose
GROUP_API_PORT=8084
GROUP_API_INSTANCE_ID=group-api-compose
FILE_API_PORT=8085
FILE_API_INSTANCE_ID=file-api-compose
SETTINGS_API_PORT=8086
SETTINGS_API_INSTANCE_ID=settings-api-compose
LOGS_API_PORT=8087
LOGS_API_INSTANCE_ID=logs-api-compose
USER_RPC_PORT=9091
GROUP_RPC_PORT=9094

CHAT_WS_PATH=/api/chat/ws/chat
CHAT_WS_SEND_BUFFER=64
CHAT_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_WS_READ_LIMIT_BYTES=1048576
CHAT_WS_PONG_WAIT=60s
CHAT_WS_PING_PERIOD=50s
CHAT_WS_WRITE_WAIT=10s
CHAT_MESSAGE_MAX_TEXT_BYTES=4096
CHAT_MESSAGE_MAX_PAYLOAD_BYTES=16384
CHAT_MESSAGE_DEPENDENCY_TIMEOUT=2s
CHAT_DELIVERY_OPERATION_TIMEOUT=1s
CHAT_PRESENCE_TTL=90s
CHAT_PRESENCE_REFRESH_INTERVAL=30s
CHAT_PRESENCE_RETRY_INTERVAL=5s
CHAT_PRESENCE_OPERATION_TIMEOUT=1s

GROUP_WS_PATH=/api/group/ws/chat
GROUP_WS_SEND_BUFFER=64
GROUP_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROUP_WS_READ_LIMIT_BYTES=1048576
GROUP_WS_PONG_WAIT=60s
GROUP_WS_PING_PERIOD=50s
GROUP_WS_WRITE_WAIT=10s
GROUP_DEPENDENCY_TIMEOUT=2s
GROUP_REDIS_OPERATION_TIMEOUT=1s

FILE_STORAGE_ROOT=/var/lib/gim/files
FILE_MAX_UPLOAD_BYTES=52428800

KAFKA_BROKERS=kafka:29092
KAFKA_AUDIT_TOPIC=gim.audit.events
KAFKA_AUDIT_CONSUMER_GROUP=gim-logs-v1
KAFKA_AUDIT_QUEUE_CAPACITY=1024
KAFKA_AUDIT_PUBLISH_TIMEOUT=750ms
KAFKA_AUDIT_RETRY_BACKOFF=100ms
KAFKA_AUDIT_MAX_ATTEMPTS=3

WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:4174
